# MongoDB Atlas connection string (required on Vercel).
# Locally, if left empty, an embedded MongoDB is started instead.
MONGODB_URI=""

# Secret used to sign login tokens. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=""

# Optional
GEMINI_API_KEY=""
APP_URL=""

# Admin accounts, created in MongoDB on first start if they don't exist yet.
# Passwords are stored hashed (bcrypt) in the database. Never commit real values.
ADMIN1_ID="PTS-CEO-001"
ADMIN1_NAME="Y D Mahendhra"
ADMIN1_USERNAME="Mahendhra"
ADMIN1_EMAIL=""
ADMIN1_PASSWORD=""

ADMIN2_ID="PTS-COO-001"
ADMIN2_NAME="P Praveen Kumar"
ADMIN2_USERNAME="Praveen"
ADMIN2_EMAIL=""
ADMIN2_PASSWORD=""

# Set to "true" for one deploy to overwrite existing admin passwords with the values above.
ADMIN_SYNC_PASSWORDS="false"
